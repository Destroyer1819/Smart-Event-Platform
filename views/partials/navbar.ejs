<%-- NAVBAR PARTIAL — Member 3 (Frontend Developer) --%>
<%-- TODO: Build responsive navbar with Bootstrap/Tailwind --%>
<%-- Show Login/Register if not logged in, Dashboard/Logout if logged in --%>
<%-- Show 'Manage Events' link only if currentUser.role === 'admin' --%>
<nav>
  <a href="/events">Home</a>
  <% if (currentUser) { %>
    <a href="/bookings/dashboard">Dashboard</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/events/manage">Manage Events</a>
      <a href="/admin/enquiries">Enquiries</a>
    <% } %>
    <a href="/logout">Logout</a>
  <% } else { %>
    <a href="/login">Login</a>
    <a href="/register">Register</a>
  <% } %>
</nav>
