<%- include('./partials/header', { title: 'Home', activePage: 'home', user: user }) %>

<!-- Hero Section -->
<section class="bg-gradient text-white py-5 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3"><i class="fas fa-calendar-alt me-3"></i>Welcome to Advanced Events</h1>
        <p class="lead mb-4">Your premier destination for corporate conferences, workshops, music festivals, and private events</p>
        <a href="/events" class="btn btn-light btn-lg"><i class="fas fa-search me-2"></i>Browse Events</a>
    </div>
</section>

<!-- Search & Filters -->
<section class="container mb-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Search & Filter Events</h5>
        </div>
        <div class="card-body">
            <form action="/" method="GET" class="row g-3">
                <div class="col-md-3">
                    <label for="search" class="form-label">Search</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           placeholder="Event name..." value="<%= searchQuery || '' %>">
                </div>
                <div class="col-md-2">
                    <label for="category" class="form-label">Category</label>
                    <select class="form-select" id="category" name="category">
                        <option value="">All Categories</option>
                        <option value="conference" <%= category === 'conference' ? 'selected' : '' %>>Conference</option>
                        <option value="workshop" <%= category === 'workshop' ? 'selected' : '' %>>Workshop</option>
                        <option value="festival" <%= category === 'festival' ? 'selected' : '' %>>Festival</option>
                        <option value="private" <%= category === 'private' ? 'selected' : '' %>>Private Event</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="date" class="form-label">Date</label>
                    <input type="date" class="form-control" id="date" name="date" value="<%= dateQuery || '' %>">
                </div>
                <div class="col-md-2">
                    <label for="availability" class="form-label">Availability</label>
                    <select class="form-select" id="availability" name="availability">
                        <option value="">All</option>
                        <option value="available" <%= availability === 'available' ? 'selected' : '' %>>Available</option>
                        <option value="limited" <%= availability === 'limited' ? 'selected' : '' %>>Limited Seats</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Events Grid -->
<section class="container mb-5">
    <h3 class="mb-4"><i class="fas fa-calendar-day me-2"></i>Upcoming Events</h3>
    
    <% if (events && events.length > 0) { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% events.forEach(function(event) { 
                const capacityPercent = (event.booked / event.capacity) * 100;
                const isAvailable = event.booked < event.capacity;
                const seatsLeft = event.capacity - event.booked;
                const isLimited = seatsLeft <= 5;
            %>
                <div class="col">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-header bg-primary text-white text-center py-4">
                            <i class="fas fa-calendar-alt fa-3x"></i>
                        </div>
                        <div class="card-body">
                            <span class="badge bg-info mb-2"><%= event.category.toUpperCase() %></span>
                            <h5 class="card-title"><%= event.title %></h5>
                            <p class="card-text text-muted"><%= event.description.substring(0, 100) %>...</p>
                            
                            <hr>
                            
                            <div class="mb-2">
                                <i class="fas fa-calendar-day text-primary me-2"></i>
                                <span><%= new Date(event.date).toLocaleDateString('en-ZA', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                            </div>
                            <div class="mb-2">
                                <i class="fas fa-clock text-primary me-2"></i>
                                <span><%= event.startTime %> - <%= event.endTime %></span>
                            </div>
                            <div class="mb-2">
                                <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                <span><%= event.location %></span>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <h4 class="text-primary mb-0">R <%= event.price.toFixed(2) %></h4>
                            </div>
                            
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small text-muted">
                                    <span><%= seatsLeft %> seats left</span>
                                    <span><%= event.booked %>/<%= event.capacity %></span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" 
                                         style="width: <%= capacityPercent %>%" 
                                         aria-valuenow="<%= capacityPercent %>" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <% if (isAvailable && user) { %>
                                <a href="/user/bookings/<%= event._id %>" class="btn btn-primary w-100">
                                    <i class="fas fa-ticket-alt me-2"></i>Book Now
                                </a>
                            <% } else if (isAvailable && !user) { %>
                                <a href="/auth/login" class="btn btn-outline-primary w-100">
                                    <i class="fas fa-sign-in-alt me-2"></i>Login to Book
                                </a>
                            <% } else { %>
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="fas fa-times-circle me-2"></i>Sold Out
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center py-5">
            <i class="fas fa-calendar-times fa-5x text-muted mb-3"></i>
            <h4>No Events Found</h4>
            <p class="text-muted">Try adjusting your search filters or check back later for new events.</p>
            <a href="/" class="btn btn-primary"><i class="fas fa-redo me-2"></i>Clear Filters</a>
        </div>
    <% } %>
</section>

<%- include('./partials/footer') %>

<style>
    .hover-card {
        transition: transform 0.3s, box-shadow 0.3s;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }
    .bg-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>
