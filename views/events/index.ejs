<%- include('../partials/header', { title: 'Events', activePage: 'events', user: typeof user !== 'undefined' ? user : null }) %>

<!-- Page Header -->
<section class="bg-gradient text-dark py-5 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <h1 class="display-5 fw-bold mb-3"><i class="fas fa-calendar-alt me-3"></i>All Events</h1>
        <p class="lead mb-0">Browse all upcoming events by Advanced Events (Pty) Ltd</p>
    </div>
</section>

<!-- Search & Filters -->
<section class="container mb-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Events</h5>
        </div>
        <div class="card-body text-dark">
            <form action="/events" method="GET" class="row g-3">
                <div class="col-md-3">
                    <label for="search" class="form-label">Search Events</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="search" name="search" 
                               placeholder="Event name..." value="<%= (typeof searchQuery !== 'undefined') ? searchQuery : '' %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <label for="category" class="form-label">Category</label>
                    <select class="form-select" id="category" name="category">
                        <option value="">All Categories</option>
                        <option value="Conference" <%= category === 'Conference' ? 'selected' : '' %>>Conference</option>
                        <option value="Workshop" <%= category === 'Workshop' ? 'selected' : '' %>>Workshop</option>
                        <option value="Music" <%= category === 'Music' ? 'selected' : '' %>>Music</option>
                        <option value="Sport" <%= category === 'Sport' ? 'selected' : '' %>>Sport</option>
                        <option value="Other" <%= category === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Events Grid -->
<section class="container mb-5">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% if (typeof events !== 'undefined' && events.length > 0) { %>
            <% events.forEach(function(event) { %>
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white text-center py-4">
                            <i class="fas fa-calendar-alt fa-3x"></i>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title"><%= event.title %></h5>
                            <p class="card-text"><%= event.description %></p>
                            <h4 class="text-primary">R <%= event.price %></h4>

                            <!-- Edit event button -->
                            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                                <div class="card-footer bg-white">
                                    <a href="/events/edit/<%= event._id %>" class="btn btn-warning w-100">
                                        <i class="fas fa-edit me-1"></i> Edit Event
                                    </a>
                                </div>
                            <% } %>
                            
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <h4>No Events Found</h4>
                <a href="/events" class="btn btn-primary">Clear Filters</a>
            </div>
        <% } %>
</section>

<%- include('../partials/footer') %>
