<%- include('./partials/header', { title: 'All Enquiries', activePage: 'contact', user: user }) %>

<div class="container mt-5">
    <h2>All Enquiries</h2>

    <% if (enquiries && enquiries.length > 0) { %>
        <table class="table table-bordered table-striped mt-4">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <% enquiries.forEach(enquiry => { %>
                    <tr>
                        <td><%= enquiry.name %></td>
                        <td><%= enquiry.email %></td>
                        <td><%= enquiry.subject %></td>
                        <td><%= enquiry.message %></td>
                        <td><%= new Date(enquiry.createdAt).toLocaleDateString('en-ZA') %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p>No enquiries found.</p>
    <% } %>
</div>

<%- include('./partials/footer') %>