<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Smart Event Platform</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('./partials/header', { title: 'Dashboard', activePage: 'dashboard', user: user }) %>

  <main class="container mt-4">

<div class="container py-4">
    
    <!-- Welcome Header -->
    <div class="bg-white text-dark p-4 rounded-3 mb-4 shadow">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-2"><i class="fas fa-user-circle me-2"></i>Welcome back, <%= user.name %>!</h2>
                <p class="mb-0">Manage your bookings with Advanced Events (Pty) Ltd</p>
            </div>
            <div class="text-end d-none d-md-block">
                <small class="text-secondary">
                    <i class="fas fa-calendar me-1"></i><%= new Date().toLocaleDateString('en-ZA', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                </small>
            </div>
        </div>
    </div>
    
    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm hover-card border-primary">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-ticket-alt fa-3x text-primary"></i>
                    </div>
                    <h3 class="mb-0 fw-bold"><%= totalBookings || 0 %></h3>
                    <p class="text-muted mb-0 small">Total Bookings</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm hover-card border-success">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-calendar-check fa-3x text-success"></i>
                    </div>
                    <h3 class="mb-0 fw-bold"><%= upcomingBookings || 0 %></h3>
                    <p class="text-muted mb-0 small">Upcoming Events</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm hover-card border-warning">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-money-bill-wave fa-3x text-warning"></i>
                    </div>
                    <h3 class="mb-0 fw-bold">R <%= totalSpent ? totalSpent.toFixed(2) : '0.00' %></h3>
                    <p class="text-muted mb-0 small">Total Spent</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm hover-card border-info">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-star fa-3x text-info"></i>
                    </div>
                    <h3 class="mb-0 fw-bold"><%= favoriteEvents || 0 %></h3>
                    <p class="text-muted mb-0 small">Favorite Events</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <a href="/events" class="btn btn-outline-primary w-100 py-3 hover-btn">
                                <i class="fas fa-search fa-2x mb-2"></i><br>
                                <span class="small">Browse Events</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="/bookings/dashboard" class="btn btn-outline-success w-100 py-3 hover-btn">
                                <i class="fas fa-list fa-2x mb-2"></i><br>
                                <span class="small">View All Bookings</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="/enquiries/contact" class="btn btn-outline-info w-100 py-3 hover-btn">
                                <i class="fas fa-envelope fa-2x mb-2"></i><br>
                                <span class="small">Contact Support</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="/bookings/dashboard" class="btn btn-outline-warning w-100 py-3 hover-btn">
                                <i class="fas fa-user-cog fa-2x mb-2"></i><br>
                                <span class="small">Settings</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Recent Bookings -->
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Bookings</h5>
                    <a href="/bookings/dashboard" class="btn btn-sm btn-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Event</th>
                                    <th>Date</th>
                                    <th>Tickets</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (bookings && bookings.length > 0) { %>
                                    <% bookings.slice(0, 5).forEach(function(booking) { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-calendar"></i>
                                                    </div>
                                                    <div>
                                                        <strong><%= booking.event.title %></strong><br>
                                                        <small class="text-muted"><%= booking.event.location %></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= new Date(booking.event.date).toLocaleDateString('en-ZA') %></td>

                                            <td><span class="badge bg-secondary"><%= booking.ticketsBooked %></span></td>

                                            <td><strong>R <%= booking.event.price.toFixed(2) %></strong></td>

                                            <td>
                                                <span class="badge bg-success">Confirmed</span>
                                            </td>
                                            <td>
                                                <a href="/bookings/dashboard" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No Bookings Yet</h5>
                                            <p class="text-muted small">Browse our events and book your first ticket!</p>
                                            <a href="/events" class="btn btn-primary">
                                                <i class="fas fa-search me-2"></i>Browse Events
                                            </a>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Upcoming Events Sidebar -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Upcoming Events</h5>
                </div>
                <div class="card-body p-0">
                    <% if (upcomingEvents && upcomingEvents.length > 0) { %>
                        <% upcomingEvents.slice(0, 3).forEach(function(event) { %>
                            <div class="p-3 border-bottom hover-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1"><%= event.title %></h6>
                                        <small class="text-muted">
                                            <i class="fas fa-calendar-day me-1"></i>
                                            <%= new Date(event.date).toLocaleDateString('en-ZA', { month: 'short', day: 'numeric' }) %>
                                        </small>
                                    </div>
                                    <span class="badge bg-primary">R <%= event.price.toFixed(2) %></span>
                                </div>
                                <a href="/bookings/book/<%= event._id %>" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                    Book Now
                                </a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="p-4 text-center">
                            <i class="fas fa-calendar-times fa-2x text-muted mb-2"></i>
                            <p class="text-muted small mb-0">No upcoming events</p>
                        </div>
                    <% } %>
                </div>
                <div class="card-footer bg-white border-top text-center">
                    <a href="/events" class="text-decoration-none">View All Events</a>
                </div>
            </div>
            
            <!-- Profile Quick Info -->
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Your Profile</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 80px; height: 80px;">
                            <i class="fas fa-user fa-2x"></i>
                        </div>
                        <h6 class="mb-0"><%= user.name %></h6>
                        <small class="text-muted"><%= user.email %></small>
                    </div>
                    <hr>
                    <div class="d-grid">
                        <a href="/bookings/dashboard" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-edit me-1"></i>Edit Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</div>

<%- include('./partials/footer') %>

<style>
    .hover-card {
        transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }
    .hover-btn {
        transition: all 0.3s;
    }
    .hover-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .hover-item {
        transition: background 0.3s;
    }
    .hover-item:hover {
        background: #f8f9fa;
    }
    .bg-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>
</main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
